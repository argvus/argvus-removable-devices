# Maintainer: William C. Canin
pkgname=argvus-taskbar-storage
pkgver=0.2.0
pkgrel=1
pkgdesc="Removable storage module for Waybar, written in Rust for the Argvus desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-taskbar-storage"
license=('GPL-3.0-only')
options=('!debug')
depends=(
  'gtk3'
  'gtk-layer-shell'
  'hyprland'
  'libnotify'
  'udisks2'
  'wl-clipboard'
  'xdg-utils'
)
optdepends=(
  'argvus-launcher: Rofi dmenu-style fallback menu mode'
)
makedepends=(
  'cargo'
  'pkgconf'
)
backup=(
  'etc/argvus/taskbar/storage/config.json'
  'etc/argvus/taskbar/storage/theme.css'
  'etc/argvus/taskbar/storage/themes/argvus-dark-silver.css'
  'etc/argvus/taskbar/storage/themes/argvus-dark-aether.css'
  'etc/argvus/taskbar/storage/themes/argvus-light-veil.css'
  'etc/argvus/taskbar/storage/themes/argvus-dark-slate.css'
  'etc/argvus/taskbar/storage/themes/argvus-dark-universe.css'
)
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release --locked --target-dir target
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --locked --target-dir target
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "target/release/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm755 config/scripts/apps/hypr-storage-menu.sh \
    "${pkgdir}/usr/share/argvus/scripts/apps/hypr-storage-menu.sh"

  install -Dm644 resources/config.json \
    "${pkgdir}/etc/argvus/taskbar/storage/config.json"
  install -Dm644 resources/theme.css \
    "${pkgdir}/etc/argvus/taskbar/storage/theme.css"

  install -dm755 "${pkgdir}/etc/argvus/taskbar/storage/themes"
  install -m644 resources/themes/*.css "${pkgdir}/etc/argvus/taskbar/storage/themes/"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
