# Maintainer: William C. Canin
pkgname=argvus-removable-devices
pkgver=0.2.0
pkgrel=1
pkgdesc="Removable storage module for Waybar, written in Rust for the Argvus desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-removable-devices"
license=('GPL-3.0-only')
options=('!debug')
replaces=('argvus-taskbar-storage' 'argvus-storage')
provides=('argvus-taskbar-storage' 'argvus-storage')
depends=(
  'gtk3'
  'gtk-layer-shell'
  'hyprland'
  'libnotify'
  'argvus-session'
  'foot'
  'udisks2'
  'wl-clipboard'
  'xdg-utils'
)
optdepends=(
  'argvus-launcher: Rofi dmenu-style fallback menu mode'
)
makedepends=(
  'cargo'
  'pkgconf'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release --locked --target-dir target
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --locked --target-dir target
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "target/release/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm755 src/usr/share/argvus/removable-devices/sh/removable-devices-menu.sh \
    "${pkgdir}/usr/share/argvus/removable-devices/sh/removable-devices-menu.sh"

  install -Dm644 src/etc/argvus/removable-devices/config.json \
    "${pkgdir}/etc/argvus/removable-devices/config.json"
  install -Dm644 src/usr/share/argvus/removable-devices/config/theme.css \
    "${pkgdir}/usr/share/argvus/removable-devices/config/theme.css"

  install -dm755 "${pkgdir}/usr/share/argvus/removable-devices/config/themes"
  install -m644 src/usr/share/argvus/removable-devices/config/themes/*.css \
    "${pkgdir}/usr/share/argvus/removable-devices/config/themes/"

  install -Dm644 src/usr/share/argvus/removable-devices/docs/README.md \
    "${pkgdir}/usr/share/argvus/removable-devices/docs/README.md"
  install -Dm644 src/usr/share/argvus/removable-devices/docs/DEVELOPMENT.md \
    "${pkgdir}/usr/share/argvus/removable-devices/docs/DEVELOPMENT.md"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
